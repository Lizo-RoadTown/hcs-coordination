__pycache__/
*.pyc
.pytest_cache/
.venv/
.env
.env.local
*.env
!.env.example

# Per-machine Claude Code state
.claude/logs/
.claude/settings.local.json

# MCP config — may contain API tokens; per-machine, not committed
.mcp.json

# Architecture snapshots — auto-generated by the loom-discipline plugin's
# SessionStart hook (and the on-demand /architecture-report command).
# Tracked in git as of 2026-11-05 (operator decision) so snapshots, diffs,
# and narratives sync across machines instead of staying local-per-machine.
# This commits a record of each session's architecture state to history.

# Private shared material (ADR 0010) — local mount of the operator's external
# synced dir ($TAPESTRY_SHARED_DIR/<slug>/) + its pointer file. Never committed;
# enforced by .githooks/pre-commit and the private-files-check CI workflow.
# No trailing slash: ignore the .shared symlink itself, not just a directory.
.shared
.tapestry-shared.local
services/docs-mcp/docs_mcp/_corpus/
services/docs-mcp/*.egg-info/
services/docs-mcp/build/
services/docs-mcp/dist/
*.egg-info/

# Playwright MCP screenshot/console dumps
.playwright-mcp/

# Redundant brand-sheet archive (extracted contents are committed)
docs/assets/*.zip

# npm at repo root (supabase CLI devDependency) — never commit the tree
node_modules/

# Operator-private material lives in the ADR-0010 shared space (.shared/), never in this PUBLIC repo
docs/canon/
docs/temp/
.agents/
.codex/
.commandcode/
.claude/skills/
skills-lock.json
# stray generated snapshots (junk; safe to delete)
services/self-observer/docs/architecture-snapshots/
